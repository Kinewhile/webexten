{
  "manifest_version": 3,
  "name": "Desktop",
  "version": "3.0",
  "permissions": ["storage", "unlimitedStorage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": { "newtab": "main.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
